## Server Configuration
PORT=20757
# Set to production on the live server (enables trust proxy and production warnings).
# NODE_ENV=production

## Database Credentials
DB_USER=avnadmin
DB_PASS=
DB_HOST=mysql-36861e2f-zolakid50-3c42.e.aivencloud.com
DB_NAME=defaultdb
DB_SSL=true
## JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

## Google Sign-In (Web OAuth client ID)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com


## Gemini API (Used for Vector Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
## Optional: text model for draft coach + answer fit (defaults to gemini-2.5-flash-lite)
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite



## Vector Search Thresholds & Settings
# Threshold for recommending similar questions
RECOMMEND_THRESHOLD=0.75
# Number of similar questions to return
RECOMMEND_K=5

## RAG (user-owned PDFs)
# Where PDFs are stored on disk (default uploads/rag under backend cwd)
RAG_UPLOAD_DIR=uploads/rag
# Max upload size in megabytes (keep small for classroom demos)
RAG_MAX_UPLOAD_MB=10
# Chunking: character window and overlap between windows
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
# Safety caps per document / per user
RAG_MAX_CHUNKS_PER_DOC=1000
RAG_MAX_PDFS_PER_USER=20
# Minimum extracted characters to treat PDF as usable text
RAG_MIN_TEXT_CHARS=50
# Semantic search: min cosine score and max hits returned
RAG_SEARCH_THRESHOLD=0.45
RAG_SEARCH_K=10


## Password Reset Email
EMAIL_SERVICE=gmail
EMAIL_USER=zolakid50@gmail.com
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173


## Deployment
# Set to 0 if the server is NOT behind a proxy. In production (NODE_ENV=production) the
# default is 1 proxy hop, which rate limiting needs to see real client IPs.
# TRUST_PROXY=1

## Notifications / Socket.IO
# Uses the same backend PORT and JWT_SECRET above; no separate socket secret is required.
# PRODUCTION: set this to your deployed frontend URL (comma-separated for several).
# It restricts which sites may open a live socket connection. Example:
# CLIENT_ORIGIN=https://forum.example.com
# If unset, FRONTEND_URL is used; if both are unset, any origin is allowed (dev only).
CLIENT_ORIGIN=http://localhost:5173
